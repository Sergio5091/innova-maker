# Serveur
# Production (VPS) : 3000, le port vers lequel Nginx proxifie api.inovamakers.io
# Local : 8000 (le 3000 est déjà pris par Next.js en dev)
PORT=3000
NODE_ENV=production

# Nombre de proxies devant l'API : 2 en production (Cloudflare + Nginx), 1 si Nginx seul, 0 en local
TRUST_PROXY=2

# Base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=inovamakers
DB_USER=inovamakers_user
DB_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Admin (compte unique)
ADMIN_EMAIL=admin@inovamakers.io
ADMIN_PASSWORD=

# CORS
CORS_ORIGIN=https://inovamakers.io
